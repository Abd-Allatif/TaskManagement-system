# Leave empty during local development: the Vite dev server proxies /api -> :5000.
# Set this to the absolute API origin when serving a production build
# (e.g. https://api.example.com/api). The backend must allow your origin via CLIENT_URL.
VITE_API_URL=

# Optional: override the dev proxy target if the backend is not on :5000.
VITE_PROXY_TARGET=http://localhost:5000
